import("//build/templates/common/copy.gni")
import("//build/version.gni")

# Assemble the openharmony/ets SDK directory from the 4 OH SDK dynamic ets
# components (api, arkts, component, kits) with noninterop labels removed.
#
# The ohos_build_dynamic_sdk_* targets run delete_arkui_label.py to strip
# noninterop annotations from the raw ohos_ets_dynamic_* output, so the
# released SDK does not expose interop-only markers.
#
# ohos_build_dynamic_sdk_api processes the entire api directory (including
# @internal/full), so no separate api_internal dependency is needed.
#
# The assembled ets/ directory is copied by ohos_copy("ets") below so that the
# ArkUI-X SDK packaging places it at arkui-x/openharmony/ets:
#   - module name "ets" (ohos_copy output dir basename)
#   - install_dir "arkui-x/openharmony" (parent, declared in SDK description)
#   -> dest = arkui-x/openharmony/ets
#
# The ets-loader config files (build_config.json, component_config.json,
# form_config.json) generated by build_ets_loader_library are copied into
# ets/component/ to match the OH OS SDK ets/dynamic/component/ layout, so the
# assembled ets package is complete without the prebuilt_sdk.py merge step.
action("assemble_openharmony_ets") {
  deps = [
    "//interface/sdk-js:ohos_build_dynamic_sdk_api",
    "//interface/sdk-js:ohos_build_dynamic_sdk_arkts",
    "//interface/sdk-js:ohos_build_dynamic_sdk_component",
    "//interface/sdk-js:ohos_build_dynamic_sdk_kits",
    "//developtools/ace_ets2bundle:build_ets_loader_library",
  ]
  script = "//interface/sdk/openharmony/assemble_ets.py"
  _api_out = get_label_info("//interface/sdk-js:ohos_build_dynamic_sdk_api",
                            "target_out_dir") + "/ohos_build_dynamic_sdk_api"
  _arkts_out = get_label_info("//interface/sdk-js:ohos_build_dynamic_sdk_arkts",
                              "target_out_dir") + "/ohos_build_dynamic_sdk_arkts"
  _component_out = get_label_info(
      "//interface/sdk-js:ohos_build_dynamic_sdk_component",
      "target_out_dir") + "/ohos_build_dynamic_sdk_component"
  _kits_out = get_label_info("//interface/sdk-js:ohos_build_dynamic_sdk_kits",
                             "target_out_dir") + "/ohos_build_dynamic_sdk_kits"
  # ets-loader config files are declared outputs of build_ets_loader_library;
  # they land in ets/component/ alongside the component .d.ets declarations.
  _ets_loader_out = get_label_info(
      "//developtools/ace_ets2bundle:build_ets_loader_library", "target_out_dir")
  _build_config = "$_ets_loader_out/build_config.json"
  _component_config = "$_ets_loader_out/component_config.json"
  _form_config = "$_ets_loader_out/form_config.json"
  inputs = [
    _api_out,
    _arkts_out,
    _component_out,
    _kits_out,
    _build_config,
    _component_config,
    _form_config,
  ]
  args = [
    "--api",
    rebase_path(_api_out, root_build_dir),
    "--arkts",
    rebase_path(_arkts_out, root_build_dir),
    "--component",
    rebase_path(_component_out, root_build_dir),
    "--kits",
    rebase_path(_kits_out, root_build_dir),
    "--output",
    rebase_path("$target_gen_dir/ets", root_build_dir),
    "--api-version",
    api_version,
    "--platform-version",
    platform_version,
    "--sdk-version",
    current_sdk_version,
    "--release-type",
    release_type,
    "--meta-version",
    meta_version,
    "--build-config",
    rebase_path(_build_config, root_build_dir),
    "--component-config",
    rebase_path(_component_config, root_build_dir),
    "--form-config",
    rebase_path(_form_config, root_build_dir),
  ]
  outputs = [
    "$target_gen_dir/ets",
    "$target_gen_dir/ets/oh-uni-package.json",
  ]
}

ohos_copy("ets") {
  deps = [ ":assemble_openharmony_ets" ]
  sources = [ "$target_gen_dir/ets" ]
  outputs = [ target_out_dir + "/$target_name/" ]
  part_name = "common"
  subsystem_name = "common"
}
